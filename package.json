{
  "name": "security-inspector",
  "version": "1.0.0",
  "description": "Flags pull requests that modify security-critical components defined by your security team, and gates merge until security review or an authorised bypass.",
  "private": true,
  "type": "module",
  "bin": {
    "security-inspector": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
